# Copie para .env (raiz do repositório, fora do Git) e troque TODAS as senhas.
# Valores abaixo são fictícios.

# --- Contêiner PostgreSQL (docker-compose.yml) ---
# Superusuário: só para o bootstrap do contêiner e para os testes de banco.
POSTGRES_USER=ares_admin
POSTGRES_PASSWORD=troque-senha-admin
POSTGRES_DB=ares
# Dono do schema (ares_owner): roda as migrações. Não é superusuário.
OWNER_DB_PASSWORD=troque-senha-owner
# Usuário da API (ares_app): só os privilégios concedidos pelas migrações.
APP_DB_PASSWORD=troque-senha-app

# --- Backend (lidas por backend/app/core/config.py) ---
ARES_ENV=dev
ARES_LOG_LEVEL=INFO
ARES_DATABASE_URL=postgresql+psycopg://ares_app:troque-senha-app@127.0.0.1:5433/ares
ARES_MIGRATION_DATABASE_URL=postgresql+psycopg://ares_owner:troque-senha-owner@127.0.0.1:5433/ares

# --- Testes de banco (backend/tests/conftest.py) ---
# Precisa criar bancos e papéis. Sem esta variável, os testes de banco são pulados.
ARES_TEST_ADMIN_DATABASE_URL=postgresql+psycopg://ares_admin:troque-senha-admin@127.0.0.1:5433/postgres
